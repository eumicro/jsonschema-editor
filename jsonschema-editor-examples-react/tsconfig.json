{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "../jsonschema-editor-examples/src/examples/catalog.ts",
    "../jsonschema-editor-examples/src/examples/demo-file-seeds.ts",
    "../jsonschema-editor-examples/src/examples/data/**/*.json"
  ]
}

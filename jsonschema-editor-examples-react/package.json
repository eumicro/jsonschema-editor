{
  "name": "jsonschema-editor-examples-react",
  "version": "0.1.12",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@jsonschema-editor/json-schema": "workspace:*",
    "@jsonschema-editor/json-schema-extensions": "workspace:*",
    "@jsonschema-editor/react": "workspace:*",
    "@jsonschema-editor/react-extensions": "workspace:*",
    "@jsonschema-editor/ui-schema": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "playwright": "^1.52.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}

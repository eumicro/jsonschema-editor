{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vehicle order",
  "description": "Order with vehicle configuration, customer data and financing",
  "type": "object",
  "required": [
    "fahrzeug",
    "kunde",
    "bestellung"
  ],
  "properties": {
    "fahrzeug": {
      "type": "object",
      "title": "Vehicle",
      "description": "Model, drive and paint",
      "required": [
        "modell",
        "antrieb",
        "lackierung"
      ],
      "properties": {
        "modell": {
          "title": "Model Line",
          "description": "Choose body variant",
          "oneOf": [
            {
              "$ref": "#/$defs/ModellLimousine"
            },
            {
              "$ref": "#/$defs/ModellSuv"
            }
          ]
        },
        "antrieb": {
          "title": "Drive",
          "description": "Combustion engine or electric drive",
          "oneOf": [
            {
              "$ref": "#/$defs/AntriebVerbrenner"
            },
            {
              "$ref": "#/$defs/AntriebElektro"
            }
          ]
        },
        "lackierung": {
          "title": "Painting",
          "description": "Standard color or individual paint",
          "anyOf": [
            {
              "$ref": "#/$defs/LackSerie"
            },
            {
              "$ref": "#/$defs/LackIndividual"
            }
          ]
        }
      }
    },
    "kunde": {
      "$ref": "#/$defs/Kunde"
    },
    "bestellung": {
      "type": "object",
      "title": "Order",
      "description": "Equipment package and method of payment",
      "required": [
        "ausstattung",
        "finanzierung"
      ],
      "properties": {
        "ausstattung": {
          "title": "Equipment package",
          "oneOf": [
            {
              "$ref": "#/$defs/PaketComfort"
            },
            {
              "$ref": "#/$defs/PaketSport"
            }
          ]
        },
        "finanzierung": {
          "title": "Financing",
          "anyOf": [
            {
              "$ref": "#/$defs/FinanzKauf"
            },
            {
              "$ref": "#/$defs/FinanzLeasing"
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "ModellLimousine": {
      "type": "object",
      "title": "Limousine",
      "required": [
        "karosserie",
        "tueren"
      ],
      "properties": {
        "karosserie": {
          "type": "string",
          "const": "limousine",
          "title": "Type"
        },
        "tueren": {
          "type": "integer",
          "title": "Doors",
          "enum": [
            4,
            5
          ]
        },
        "radstandMm": {
          "type": "integer",
          "title": "Wheelbase (mm)"
        }
      }
    },
    "ModellSuv": {
      "type": "object",
      "title": "SUV",
      "required": [
        "karosserie",
        "tueren"
      ],
      "properties": {
        "karosserie": {
          "type": "string",
          "const": "suv",
          "title": "Type"
        },
        "tueren": {
          "type": "integer",
          "title": "Doors",
          "const": 5
        },
        "bodenhoeheMm": {
          "type": "integer",
          "title": "Ground clearance (mm)"
        }
      }
    },
    "AntriebVerbrenner": {
      "type": "object",
      "title": "Combustor",
      "required": [
        "art",
        "hubraum",
        "leistungPs"
      ],
      "properties": {
        "art": {
          "type": "string",
          "const": "verbrenner",
          "title": "Art"
        },
        "hubraum": {
          "type": "integer",
          "title": "Displacement (cm³)"
        },
        "leistungPs": {
          "type": "integer",
          "title": "Power (HP)"
        },
        "getriebe": {
          "type": "string",
          "title": "Gearbox",
          "enum": [
            "Schaltung",
            "Automatik"
          ]
        }
      }
    },
    "AntriebElektro": {
      "type": "object",
      "title": "Electric",
      "required": [
        "art",
        "batterieKwh",
        "reichweiteKm"
      ],
      "properties": {
        "art": {
          "type": "string",
          "const": "elektro",
          "title": "Art"
        },
        "batterieKwh": {
          "type": "number",
          "title": "Battery (kWh)"
        },
        "reichweiteKm": {
          "type": "integer",
          "title": "Range WLTP (km)"
        }
      }
    },
    "LackSerie": {
      "type": "object",
      "title": "Series paint",
      "required": [
        "lackArt",
        "farbe"
      ],
      "properties": {
        "lackArt": {
          "type": "string",
          "const": "serie",
          "title": "Art"
        },
        "farbe": {
          "type": "string",
          "title": "Color",
          "enum": [
            "Schwarz",
            "Weiß",
            "Grau"
          ]
        }
      }
    },
    "LackIndividual": {
      "type": "object",
      "title": "Individual",
      "required": [
        "lackArt",
        "farbcode"
      ],
      "properties": {
        "lackArt": {
          "type": "string",
          "const": "individual",
          "title": "Art"
        },
        "farbcode": {
          "type": "string",
          "title": "Color code"
        },
        "aufpreis": {
          "type": "number",
          "title": "Surcharge (€)"
        }
      }
    },
    "Kunde": {
      "type": "object",
      "title": "Customer",
      "required": [
        "vorname",
        "nachname",
        "email"
      ],
      "properties": {
        "vorname": {
          "type": "string",
          "title": "First name"
        },
        "nachname": {
          "type": "string",
          "title": "Last name"
        },
        "email": {
          "type": "string",
          "title": "Email"
        }
      }
    },
    "PaketComfort": {
      "type": "object",
      "title": "Comfort",
      "required": [
        "paket"
      ],
      "properties": {
        "paket": {
          "type": "string",
          "const": "comfort",
          "title": "Package"
        },
        "klimaautomatik": {
          "type": "boolean",
          "title": "Automatic climate control"
        },
        "sitzheizung": {
          "type": "boolean",
          "title": "Heated seats"
        }
      }
    },
    "PaketSport": {
      "type": "object",
      "title": "Sport",
      "required": [
        "paket",
        "sportfahrwerk"
      ],
      "properties": {
        "paket": {
          "type": "string",
          "const": "sport",
          "title": "Package"
        },
        "sportfahrwerk": {
          "type": "boolean",
          "title": "Sports suspension"
        },
        "felgenZoll": {
          "type": "integer",
          "title": "Rims (inch)"
        }
      }
    },
    "FinanzKauf": {
      "type": "object",
      "title": "Purchase",
      "required": [
        "finanzArt"
      ],
      "properties": {
        "finanzArt": {
          "type": "string",
          "const": "kauf",
          "title": "Art"
        },
        "anzahlung": {
          "type": "number",
          "title": "Deposit (€)"
        }
      }
    },
    "FinanzLeasing": {
      "type": "object",
      "title": "Leasing",
      "required": [
        "finanzArt",
        "laufzeitMonate"
      ],
      "properties": {
        "finanzArt": {
          "type": "string",
          "const": "leasing",
          "title": "Art"
        },
        "laufzeitMonate": {
          "type": "integer",
          "title": "Duration (months)"
        },
        "jahreskilometer": {
          "type": "integer",
          "title": "Annual kilometers"
        }
      }
    }
  }
}

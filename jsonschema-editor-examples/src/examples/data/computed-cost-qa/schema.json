{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Cost estimate",
  "properties": {
    "positionen": {
      "type": "array",
      "title": "Cost items",
      "items": {
        "type": "object",
        "title": "Cost item",
        "properties": {
          "bezeichnung": {
            "type": "string",
            "title": "Designation"
          },
          "betrag": {
            "type": "number",
            "title": "Amount (EUR)"
          }
        },
        "required": [
          "bezeichnung",
          "betrag"
        ]
      }
    },
    "gesamtsumme": {
      "type": "number",
      "title": "Total (EUR)",
      "description": "Is calculated automatically from all positions",
      "x-computed": {
        "expression": "data.positionen.map(p, double(p.betrag)).sum()"
      }
    }
  }
}

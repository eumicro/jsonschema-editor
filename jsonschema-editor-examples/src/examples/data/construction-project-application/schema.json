{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Construction project registration",
  "description": "Formal construction project from application to submission",
  "type": "object",
  "properties": {
    "antrag": {
      "type": "object",
      "title": "Application",
      "required": [
        "antragsnummer",
        "antragsdatum",
        "verfahrensart"
      ],
      "properties": {
        "antragsnummer": {
          "type": "string",
          "title": "Application number",
          "description": "File number / process ID"
        },
        "antragsdatum": {
          "type": "string",
          "format": "date",
          "title": "Application date"
        },
        "verfahrensart": {
          "type": "string",
          "title": "Type of procedure",
          "enum": [
            "Genehmigungsfreistellung",
            "Bauantrag",
            "Bauvoranfrage"
          ],
          "x-values-source": {
            "kind": "static",
            "values": [
              "Genehmigungsfreistellung",
              "Bauantrag",
              "Bauvoranfrage"
            ]
          }
        },
        "bauvorhabenBezeichnung": {
          "type": "string",
          "title": "Name of the construction project"
        }
      }
    },
    "bauherr": {
      "type": "object",
      "title": "Builder",
      "required": [
        "name",
        "email",
        "telefon"
      ],
      "properties": {
        "name": {
          "type": "string",
          "title": "Name/Company"
        },
        "ansprechpartner": {
          "type": "string",
          "title": "Contact Person"
        },
        "email": {
          "type": "string",
          "format": "email",
          "title": "Email"
        },
        "telefon": {
          "type": "string",
          "format": "phone",
          "title": "Phone"
        },
        "steuerId": {
          "type": "string",
          "title": "Tax ID / VAT ID no."
        }
      }
    },
    "grundstueck": {
      "type": "object",
      "title": "Property",
      "required": [
        "adresse",
        "gemarkung",
        "flurstueck"
      ],
      "properties": {
        "adresse": {
          "type": "string",
          "title": "Location (address)"
        },
        "gemarkung": {
          "type": "string",
          "title": "District"
        },
        "flurstueck": {
          "type": "string",
          "title": "Parcel"
        },
        "grundstuecksflaecheQm": {
          "type": "number",
          "title": "Property area (m²)",
          "minimum": 0
        },
        "grundstueckKarte": {
          "type": "object",
          "title": "Property boundary (map)",
          "description": "Parcel or planned building area as a polygon",
          "x-geometry": {
            "styleUrl": "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
            "point": false,
            "line": false,
            "polygon": true,
            "maxObjects": 1
          }
        },
        "denkmalschutz": {
          "type": "boolean",
          "title": "Monument protection/ensemble protection"
        },
        "altlastenVerdacht": {
          "type": "boolean",
          "title": "Suspicion of contaminated sites known"
        }
      }
    },
    "vorhaben": {
      "title": "Plan",
      "oneOf": [
        {
          "$ref": "#/$defs/VorhabenNeubau"
        },
        {
          "$ref": "#/$defs/VorhabenUmbau"
        },
        {
          "$ref": "#/$defs/VorhabenAbbruch"
        }
      ]
    },
    "nutzung": {
      "title": "Use",
      "oneOf": [
        {
          "$ref": "#/$defs/NutzungWohnen"
        },
        {
          "$ref": "#/$defs/NutzungGewerbe"
        },
        {
          "$ref": "#/$defs/NutzungGemischt"
        }
      ]
    },
    "gebaeude": {
      "type": "object",
      "title": "Building characteristics",
      "properties": {
        "geschosse": {
          "type": "integer",
          "title": "Number of floors",
          "minimum": 1,
          "maximum": 50
        },
        "firstHoeheM": {
          "type": "number",
          "title": "Ridge height (m)",
          "minimum": 0
        },
        "stellplaetze": {
          "type": "integer",
          "title": "Pitches",
          "minimum": 0
        },
        "barrierefrei": {
          "type": "boolean",
          "title": "Barrier-free access planned"
        }
      }
    },
    "gewerke": {
      "type": "array",
      "title": "Trades/service packages",
      "minItems": 1,
      "items": {
        "type": "object",
        "title": "Trade",
        "required": [
          "bezeichnung",
          "kostenEur"
        ],
        "properties": {
          "bezeichnung": {
            "type": "string",
            "title": "Trade",
            "enum": [
              "Erdarbeiten",
              "Rohbau",
              "Dach",
              "Fassade",
              "Haustechnik",
              "Innenausbau",
              "Außenanlagen"
            ]
          },
          "beschreibung": {
            "type": "string",
            "title": "Description of services"
          },
          "kostenEur": {
            "type": "number",
            "title": "Costs (EUR)",
            "minimum": 0
          },
          "beginn": {
            "type": "string",
            "format": "date",
            "title": "Planned start"
          },
          "ende": {
            "type": "string",
            "format": "date",
            "title": "Planned end"
          },
          "subunternehmer": {
            "type": "string",
            "title": "Subcontractor (optional)"
          }
        }
      }
    },
    "baustelle": {
      "type": "object",
      "title": "Construction site & logistics",
      "properties": {
        "zufahrtKarte": {
          "type": "object",
          "title": "Construction site access (map)",
          "x-geometry": {
            "styleUrl": "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
            "point": true,
            "line": false,
            "polygon": false,
            "maxObjects": 1
          }
        },
        "baustellenbereich": {
          "type": "object",
          "title": "Construction site traffic / barrier (map)",
          "description": "Planned access or barrier route",
          "x-geometry": {
            "styleUrl": "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
            "point": false,
            "line": true,
            "polygon": false,
            "maxObjects": 1
          }
        },
        "baustelleneinrichtung": {
          "type": "object",
          "title": "Construction site equipment",
          "properties": {
            "container": {
              "type": "boolean",
              "title": "Office container"
            },
            "kran": {
              "type": "boolean",
              "title": "Tower crane"
            },
            "materialLagerflaecheQm": {
              "type": "number",
              "title": "Material storage area (m²)"
            }
          }
        },
        "arbeitszeiten": {
          "type": "string",
          "title": "Regular working hours",
          "description": "E.g. E.g. Mon–Fri 7:00 a.m.–6:00 p.m"
        }
      }
    },
    "umwelt": {
      "type": "object",
      "title": "Environment & Neighborhood",
      "properties": {
        "laerm": {
          "type": "object",
          "title": "Noise protection",
          "properties": {
            "laermempfindlich": {
              "type": "boolean",
              "title": "Noise-sensitive zone"
            },
            "schallschutzMassnahmen": {
              "type": "string",
              "title": "Planned noise protection measures"
            },
            "nachtarbeit": {
              "type": "boolean",
              "title": "Night or special work planned"
            }
          }
        },
        "abfall": {
          "type": "object",
          "title": "Waste & disposal",
          "properties": {
            "bautrocknung": {
              "type": "boolean",
              "title": "Building drying required"
            },
            "asbestVerdacht": {
              "type": "boolean",
              "title": "Suspected asbestos"
            },
            "entsorgungskonzept": {
              "type": "string",
              "title": "Disposal concept"
            }
          }
        },
        "nachbarn": {
          "type": "array",
          "title": "Neighborhood (notification)",
          "items": {
            "type": "object",
            "title": "Neighbor",
            "properties": {
              "name": {
                "type": "string",
                "title": "Name"
              },
              "adresse": {
                "type": "string",
                "title": "Address"
              },
              "benachrichtigt": {
                "type": "boolean",
                "title": "Notified"
              },
              "einwendung": {
                "type": "boolean",
                "title": "Objection received"
              }
            }
          }
        }
      }
    },
    "kalkulation": {
      "type": "object",
      "title": "Calculation",
      "properties": {
        "baukostenSumme": {
          "type": "number",
          "title": "Total construction costs (EUR)",
          "x-computed": {
            "expression": "data.gewerke.map(g, double(g.kostenEur)).sum()"
          }
        },
        "geschaetzteFlaecheQm": {
          "type": "number",
          "title": "Estimated relevant area (m²)",
          "x-computed": {
            "expression": "has(data.vorhaben.typ) && data.vorhaben.typ == 'neubau' ? double(data.vorhaben.bruttogrundflaeche) : has(data.vorhaben.typ) && data.vorhaben.typ == 'umbau' ? double(data.vorhaben.umbauFlaeche) : has(data.vorhaben.typ) && data.vorhaben.typ == 'abbruch' ? double(data.vorhaben.abbruchFlaeche) : 0.0"
          }
        },
        "co2SchaetzungKg": {
          "type": "number",
          "title": "CO₂ estimate construction (kg)",
          "description": "Simplified estimate based on area and type of use",
          "x-computed": {
            "expression": "(has(data.vorhaben.typ) && data.vorhaben.typ == 'neubau' ? double(data.vorhaben.bruttogrundflaeche) : has(data.vorhaben.typ) && data.vorhaben.typ == 'umbau' ? double(data.vorhaben.umbauFlaeche) : has(data.vorhaben.typ) && data.vorhaben.typ == 'abbruch' ? double(data.vorhaben.abbruchFlaeche) : 0.0) * (has(data.nutzung.typ) && data.nutzung.typ == 'gewerbe' ? 80.0 : has(data.nutzung.typ) && data.nutzung.typ == 'gemischt' ? 60.0 : 45.0)"
          }
        },
        "vollstaendigkeitProzent": {
          "type": "integer",
          "title": "Document completeness (%)",
          "x-computed": {
            "expression": "(has(data.antrag.antragsdatum) && data.antrag.antragsdatum != '' ? 15 : 0) + (has(data.grundstueck.adresse) && data.grundstueck.adresse != '' ? 15 : 0) + (has(data.vorhaben.typ) ? 20 : 0) + (data.gewerke.size() > 0 ? 20 : 0) + (data.einreichung.lageplanVorhanden ? 15 : 0) + (data.einreichung.statikVorhanden ? 15 : 0)"
          }
        }
      }
    },
    "einreichung": {
      "type": "object",
      "title": "Submission",
      "properties": {
        "lageplanVorhanden": {
          "type": "boolean",
          "title": "Site map attached"
        },
        "statikVorhanden": {
          "type": "boolean",
          "title": "Statics/structural plan attached"
        },
        "energieNachweisVorhanden": {
          "type": "boolean",
          "title": "Energy certificate attached"
        },
        "bauherrBestaetigt": {
          "type": "boolean",
          "title": "Builder confirms accuracy"
        },
        "architektBestaetigt": {
          "type": "boolean",
          "title": "Draft author confirms completeness"
        },
        "einreichungsDatum": {
          "type": "string",
          "format": "date",
          "title": "Submission date"
        },
        "sachbearbeiter": {
          "type": "string",
          "title": "Building department clerk"
        },
        "interneNotiz": {
          "type": "string",
          "title": "Internal note"
        }
      }
    },
    "antragsStatus": {
      "type": "string",
      "title": "Processing status",
      "enum": [
        "NEU",
        "ANTRAG_ERFASST",
        "GRUNDSTUECK_ERFASST",
        "VORHABEN_DEFINIERT",
        "GEWERKE_ERFASST",
        "BAUSTELLE_GEPLANT",
        "KALKULIERT",
        "UNTERLAGEN_VOLLSTAENDIG",
        "EINGEREICHT"
      ],
      "x-computed": {
        "expression": "!has(data.antrag.antragsdatum) || data.antrag.antragsdatum == '' ? 'NEU' : (!has(data.grundstueck.adresse) || data.grundstueck.adresse == '') ? 'ANTRAG_ERFASST' : (!has(data.vorhaben.typ)) ? 'GRUNDSTUECK_ERFASST' : (data.gewerke.size() == 0) ? 'VORHABEN_DEFINIERT' : (!has(data.baustelle.arbeitszeiten) || data.baustelle.arbeitszeiten == '') ? 'GEWERKE_ERFASST' : (double(data.kalkulation.baukostenSumme) <= 0.0) ? 'BAUSTELLE_GEPLANT' : (!data.einreichung.lageplanVorhanden || !data.einreichung.statikVorhanden) ? 'KALKULIERT' : (!data.einreichung.bauherrBestaetigt || !data.einreichung.architektBestaetigt) ? 'UNTERLAGEN_VOLLSTAENDIG' : (!has(data.einreichung.einreichungsDatum) || data.einreichung.einreichungsDatum == '') ? 'UNTERLAGEN_VOLLSTAENDIG' : 'EINGEREICHT'"
      }
    }
  },
  "$defs": {
    "VorhabenNeubau": {
      "type": "object",
      "title": "New building",
      "required": [
        "typ",
        "bruttogrundflaeche"
      ],
      "properties": {
        "typ": {
          "type": "string",
          "const": "neubau",
          "title": "Art"
        },
        "bruttogrundflaeche": {
          "type": "number",
          "title": "Gross floor area (m²)",
          "minimum": 1
        },
        "wohneinheiten": {
          "type": "integer",
          "title": "Number of residential units",
          "minimum": 0
        },
        "massivbauweise": {
          "type": "string",
          "title": "Construction method",
          "enum": [
            "Massiv",
            "Holz",
            "Hybrid"
          ]
        }
      }
    },
    "VorhabenUmbau": {
      "type": "object",
      "title": "Conversion/renovation",
      "required": [
        "typ",
        "umbauFlaeche",
        "umbauArt"
      ],
      "properties": {
        "typ": {
          "type": "string",
          "const": "umbau",
          "title": "Art"
        },
        "umbauFlaeche": {
          "type": "number",
          "title": "Conversion area (m²)",
          "minimum": 1
        },
        "umbauArt": {
          "type": "string",
          "title": "Modification type",
          "enum": [
            "Kernsanierung",
            "Aufstockung",
            "Anbau",
            "Nutzungsänderung"
          ]
        },
        "bestandsbauJahr": {
          "type": "integer",
          "title": "Year of construction of existing building"
        }
      }
    },
    "VorhabenAbbruch": {
      "type": "object",
      "title": "Abort",
      "required": [
        "typ",
        "abbruchFlaeche"
      ],
      "properties": {
        "typ": {
          "type": "string",
          "const": "abbruch",
          "title": "Art"
        },
        "abbruchFlaeche": {
          "type": "number",
          "title": "Demolition area (m²)",
          "minimum": 1
        },
        "teilabbruch": {
          "type": "boolean",
          "title": "Partial demolition"
        },
        "schadstoffgutachten": {
          "type": "boolean",
          "title": "Pollutant reports available"
        }
      }
    },
    "NutzungWohnen": {
      "type": "object",
      "title": "Reside",
      "required": [
        "typ",
        "wohnform"
      ],
      "properties": {
        "typ": {
          "type": "string",
          "const": "wohnen",
          "title": "Art"
        },
        "wohnform": {
          "type": "string",
          "title": "Type of living",
          "enum": [
            "Einfamilienhaus",
            "Mehrfamilienhaus",
            "Studentisches Wohnen"
          ]
        },
        "foerderprogramm": {
          "type": "boolean",
          "title": "Public funding applied for"
        }
      }
    },
    "NutzungGewerbe": {
      "type": "object",
      "title": "Commercial",
      "required": [
        "typ",
        "gewerbeart"
      ],
      "properties": {
        "typ": {
          "type": "string",
          "const": "gewerbe",
          "title": "Art"
        },
        "gewerbeart": {
          "type": "string",
          "title": "Type of business",
          "enum": [
            "Büro",
            "Handel",
            "Produktion",
            "Logistik"
          ]
        },
        "schwerlastverkehr": {
          "type": "boolean",
          "title": "Heavy traffic expected"
        }
      }
    },
    "NutzungGemischt": {
      "type": "object",
      "title": "Mixed use",
      "required": [
        "typ",
        "wohnanteilProzent",
        "gewerbeanteilProzent"
      ],
      "properties": {
        "typ": {
          "type": "string",
          "const": "gemischt",
          "title": "Art"
        },
        "wohnanteilProzent": {
          "type": "integer",
          "title": "Residential share (%)",
          "minimum": 1,
          "maximum": 99
        },
        "gewerbeanteilProzent": {
          "type": "integer",
          "title": "Commercial share (%)",
          "minimum": 1,
          "maximum": 99
        },
        "mischnutzungImErdgeschoss": {
          "type": "boolean",
          "title": "Commercial on the ground floor"
        }
      }
    }
  }
}

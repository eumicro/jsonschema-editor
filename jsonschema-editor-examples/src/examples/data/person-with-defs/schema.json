{
  "oneOf": [
    {
      "$ref": "#/$defs/Mensch"
    },
    {
      "$ref": "#/$defs/Maschine"
    }
  ],
  "title": "Contact Person",
  "description": "Enter a person or an assigned asset with contact details",
  "$defs": {
    "Mensch": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "title": "Name",
          "description": "Full name"
        },
        "email": {
          "type": "string",
          "format": "email",
          "title": "Email",
          "description": "Business email address"
        },
        "website": {
          "type": "string",
          "format": "uri",
          "title": "Website",
          "description": "Department or company website"
        },
        "phone": {
          "type": "string",
          "format": "phone",
          "title": "Phone",
          "description": "Telephone number with country code"
        },
        "abteilung": {
          "type": "string",
          "title": "Department",
          "description": "Responsible department",
          "enum": [
            "Vertrieb",
            "Entwicklung",
            "Support"
          ],
          "x-values-source": {
            "kind": "static",
            "values": [
              "Vertrieb",
              "Entwicklung",
              "Support"
            ]
          }
        },
        "manager": {
          "type": "string",
          "title": "Superior",
          "description": "Selection from the employee list",
          "x-values-source": {
            "kind": "fetch",
            "url": "https://jsonplaceholder.typicode.com/users",
            "valueField": "id",
            "labelField": "name"
          }
        }
      },
      "required": [
        "name"
      ],
      "title": "Person",
      "description": "Natural person with contact details"
    },
    "Maschine": {
      "type": "object",
      "properties": {
        "nummer": {
          "type": "string",
          "title": "Number",
          "description": "Serial or inventory number"
        }
      },
      "required": [
        "nummer"
      ],
      "title": "Operating resources",
      "description": "Device or system with inventory number"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "G37 screen precaution",
  "description": "Occupational health care at computer workstations according to DGUV G37",
  "type": "object",
  "required": [
    "aktenzeichen",
    "untersuchungsdatum",
    "vorgeschichte",
    "untersuchter",
    "arbeitgeber",
    "programm",
    "anamnese",
    "beurteilung",
    "beratung",
    "mitteilungArbeitgeber",
    "attest"
  ],
  "properties": {
    "aktenzeichen": {
      "type": "string",
      "title": "File number",
      "description": "Internal precautionary file / practice number"
    },
    "vorsorgeStatus": {
      "type": "string",
      "title": "Precaution status",
      "description": "Processing status from form progress (CEL)",
      "enum": [
        "NEU",
        "AUFNAHME",
        "ANAMNESE",
        "UNTERSUCHUNG",
        "BEURTEILUNG",
        "ATTEST_OFFEN",
        "ABGESCHLOSSEN"
      ],
      "x-computed": {
        "expression": "!has(data.aktenzeichen) || data.aktenzeichen == '' ? 'NEU' : (!has(data.untersuchungsdatum) || data.untersuchungsdatum == '') ? 'AUFNAHME' : (!has(data.anamnese.allgemein.beschwerdenFreitext) || data.anamnese.allgemein.beschwerdenFreitext == '') ? 'ANAMNESE' : (!has(data.programm)) ? 'UNTERSUCHUNG' : (!has(data.beurteilung)) ? 'BEURTEILUNG' : (!(has(data.attest.unterschriftErteilt) && data.attest.unterschriftErteilt)) ? 'ATTEST_OFFEN' : 'ABGESCHLOSSEN'"
      }
    },
    "untersuchungsdatum": {
      "type": "string",
      "format": "date",
      "title": "Examination date"
    },
    "vorgeschichte": {
      "$ref": "#/$defs/Vorgeschichte"
    },
    "untersuchter": {
      "$ref": "#/$defs/Untersuchter"
    },
    "arbeitgeber": {
      "$ref": "#/$defs/Arbeitgeber"
    },
    "programm": {
      "title": "Investigation program",
      "description": "OneOf: Initial, follow-up or supplementary examination according to G37",
      "oneOf": [
        {
          "$ref": "#/$defs/ProgrammErst"
        },
        {
          "$ref": "#/$defs/ProgrammNach"
        },
        {
          "$ref": "#/$defs/ProgrammErgaenzung"
        }
      ]
    },
    "anamnese": {
      "$ref": "#/$defs/Anamnese"
    },
    "beurteilung": {
      "title": "Occupational health assessment",
      "description": "OneOf: Result for employers (without diagnoses)",
      "oneOf": [
        {
          "$ref": "#/$defs/BeurteilungKeineBedenken"
        },
        {
          "$ref": "#/$defs/BeurteilungMitEmpfehlungen"
        },
        {
          "$ref": "#/$defs/BeurteilungErgaenzungNoetig"
        }
      ]
    },
    "beratung": {
      "$ref": "#/$defs/Beratung"
    },
    "mitteilungArbeitgeber": {
      "$ref": "#/$defs/MitteilungArbeitgeber"
    },
    "attest": {
      "$ref": "#/$defs/Attest"
    }
  },
  "$defs": {
    "Untersuchter": {
      "type": "object",
      "title": "Examined person",
      "required": [
        "personalnummer",
        "nachname",
        "vorname",
        "geburtsdatum",
        "geschlecht"
      ],
      "properties": {
        "personalnummer": {
          "type": "string",
          "title": "Personnel number"
        },
        "nachname": {
          "type": "string",
          "title": "Last name"
        },
        "vorname": {
          "type": "string",
          "title": "First name"
        },
        "geburtsdatum": {
          "type": "string",
          "format": "date",
          "title": "Birth Date"
        },
        "geschlecht": {
          "type": "string",
          "title": "Gender",
          "enum": [
            "weiblich",
            "männlich",
            "divers",
            "unbekannt"
          ]
        },
        "versichertennummer": {
          "type": "string",
          "title": "Health insurance number",
          "description": "Optional, for internal documentation only"
        }
      }
    },
    "Arbeitgeber": {
      "type": "object",
      "title": "Employer/company",
      "required": [
        "firma",
        "standort",
        "taetigkeit"
      ],
      "properties": {
        "firma": {
          "type": "string",
          "title": "Company"
        },
        "standort": {
          "type": "string",
          "title": "Location/Department"
        },
        "taetigkeit": {
          "type": "string",
          "title": "Activity (short description)"
        },
        "vorgesetzter": {
          "type": "string",
          "title": "HR contact person"
        },
        "kontaktEmail": {
          "type": "string",
          "format": "email",
          "title": "Contact email"
        },
        "betriebsgelaende": {
          "type": "object",
          "title": "Company premises",
          "description": "OGC Simple Features as GeoJSON GeometryCollection (map)",
          "x-geometry": {
            "styleUrl": "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
            "point": false,
            "line": false,
            "polygon": true,
            "maxObjects": 1
          }
        }
      }
    },
    "Anamnese": {
      "type": "object",
      "title": "Anamnesis",
      "required": [
        "allgemein",
        "arbeit"
      ],
      "properties": {
        "allgemein": {
          "type": "object",
          "title": "General anamnesis",
          "required": [
            "beschwerdenFreitext"
          ],
          "properties": {
            "beschwerdenFreitext": {
              "type": "string",
              "title": "Current complaints",
              "description": "Free text according to G37 3.1.1"
            },
            "augenbeschwerden": {
              "type": "boolean",
              "title": "Eye problems/eye diseases"
            },
            "bewegungsapparat": {
              "type": "boolean",
              "title": "Musculoskeletal complaints"
            },
            "neurologisch": {
              "type": "boolean",
              "title": "Neurological disorders"
            },
            "stoffwechsel": {
              "type": "boolean",
              "title": "Metabolic diseases (e.g. diabetes)"
            },
            "bluthochdruck": {
              "type": "boolean",
              "title": "High blood pressure"
            },
            "medikation": {
              "type": "string",
              "title": "Long-term medication"
            },
            "sehhilfeVorhanden": {
              "type": "boolean",
              "title": "Visual aid available"
            },
            "sehhilfeArt": {
              "type": "string",
              "title": "Type of visual aid",
              "enum": [
                "Brille",
                "Kontaktlinsen",
                "Bildschirmarbeitsplatzbrille",
                "Keine"
              ]
            }
          },
          "if": {
            "properties": {
              "sehhilfeVorhanden": {
                "const": true
              }
            },
            "required": [
              "sehhilfeVorhanden"
            ]
          },
          "then": {
            "required": [
              "sehhilfeArt"
            ]
          }
        },
        "arbeit": {
          "type": "object",
          "title": "Work history",
          "required": [
            "arbeitsplatz",
            "bildschirmStundenProTag"
          ],
          "properties": {
            "arbeitsplatz": {
              "type": "string",
              "title": "Workplace/space"
            },
            "arbeitsaufgabe": {
              "type": "string",
              "title": "Work Task"
            },
            "arbeitseinweisungErfolgt": {
              "type": "boolean",
              "title": "Work briefing/briefing at the screen location takes place"
            },
            "arbeitszeitStundenWoche": {
              "type": "number",
              "title": "Working hours (h/week)",
              "minimum": 1,
              "maximum": 60
            },
            "bildschirmStundenProTag": {
              "type": "number",
              "title": "Screen time (h/day)",
              "minimum": 0,
              "maximum": 16
            },
            "pausenRegelung": {
              "type": "boolean",
              "title": "Regular screen breaks"
            },
            "beleuchtungOk": {
              "type": "boolean",
              "title": "Lighting in the workplace is sufficient"
            },
            "blendfrei": {
              "type": "boolean",
              "title": "Anti-glare screen placement"
            },
            "abstandCm": {
              "type": "integer",
              "title": "Distance between eyes and screen (cm)",
              "minimum": 30,
              "maximum": 120
            },
            "farbsehenErforderlich": {
              "type": "boolean",
              "title": "Color discrimination required for activity"
            }
          }
        }
      }
    },
    "SiebtestFern": {
      "type": "object",
      "title": "Distance visual acuity",
      "required": [
        "rechts",
        "links",
        "beidauge"
      ],
      "properties": {
        "rechts": {
          "type": "number",
          "title": "Right",
          "minimum": 0,
          "maximum": 2
        },
        "links": {
          "type": "number",
          "title": "Left",
          "minimum": 0,
          "maximum": 2
        },
        "beidauge": {
          "type": "number",
          "title": "Binocular",
          "minimum": 0,
          "maximum": 2
        },
        "mitSehhilfe": {
          "type": "boolean",
          "title": "Checked with visual aids"
        },
        "grenzwertErreicht": {
          "type": "boolean",
          "title": "Minimum requirement ≥ 0.8 achieved",
          "description": "G37 Table 1: 0.8/0.8"
        }
      }
    },
    "SiebtestNaehe": {
      "type": "object",
      "title": "Visual acuity near (workplace-related)",
      "required": [
        "entfernungCm",
        "rechts",
        "links"
      ],
      "properties": {
        "entfernungCm": {
          "type": "integer",
          "title": "Test distance (cm)",
          "enum": [
            33,
            55,
            70
          ]
        },
        "rechts": {
          "type": "number",
          "title": "Right",
          "minimum": 0,
          "maximum": 2
        },
        "links": {
          "type": "number",
          "title": "Left",
          "minimum": 0,
          "maximum": 2
        },
        "mitSehhilfe": {
          "type": "boolean",
          "title": "Tested with workplace visual aids"
        },
        "grenzwertErreicht": {
          "type": "boolean",
          "title": "Minimum requirement ≥ 0.8 achieved"
        }
      }
    },
    "SiebtestWeitere": {
      "type": "object",
      "title": "Other screening test features",
      "required": [
        "stereopsis",
        "phorie",
        "gesichtsfeld"
      ],
      "properties": {
        "stereopsis": {
          "type": "string",
          "title": "Stereopsis (spatial vision)",
          "enum": [
            "regelrecht",
            "auffällig",
            "nicht geprüft"
          ]
        },
        "phorie": {
          "type": "string",
          "title": "Phoria / eye position",
          "enum": [
            "regelrecht",
            "auffällig",
            "nicht geprüft"
          ]
        },
        "gesichtsfeld": {
          "type": "string",
          "title": "Central visual field",
          "enum": [
            "regelrecht",
            "auffällig",
            "nicht geprüft"
          ]
        },
        "farbensinn": {
          "type": "string",
          "title": "Color sense",
          "enum": [
            "regelrecht",
            "auffällig",
            "nicht erforderlich",
            "nicht geprüft"
          ]
        },
        "ergebnisKategorie": {
          "type": "string",
          "title": "Result of the screening test (G37 assessment scheme)",
          "description": "A) visual acuity ok b) visual acuity not ok c) other features ok d) other features noticeable",
          "enum": [
            "a_sehschaerfe_erfüllt",
            "b_sehschaerfe_nicht_erfüllt",
            "c_weitere_merkmale_erfüllt",
            "d_weitere_merkmale_auffaellig"
          ]
        },
        "gesichtsfeldGrund": {
          "type": "string",
          "title": "Reason for the visual field test",
          "enum": [
            "Alter ≥ 50",
            "Beschwerden",
            "Routine Erstuntersuchung",
            "Nicht geprüft"
          ]
        }
      }
    },
    "SiebtestVoll": {
      "type": "object",
      "title": "Screening test",
      "required": [
        "ferne",
        "naehe",
        "weitere"
      ],
      "properties": {
        "ferne": {
          "$ref": "#/$defs/SiebtestFern"
        },
        "naehe": {
          "$ref": "#/$defs/SiebtestNaehe"
        },
        "weitere": {
          "$ref": "#/$defs/SiebtestWeitere"
        }
      }
    },
    "SiebtestNach": {
      "type": "object",
      "title": "Screening test (follow-up examination)",
      "required": [
        "ferne",
        "naehe"
      ],
      "properties": {
        "ferne": {
          "$ref": "#/$defs/SiebtestFern"
        },
        "naehe": {
          "$ref": "#/$defs/SiebtestNaehe"
        }
      }
    },
    "ErgaenzungDetail": {
      "type": "object",
      "title": "Supplementary examination (eye diagnostic)",
      "required": [
        "refraktion",
        "binokular",
        "peripheresGesichtsfeld",
        "organbefund",
        "augeninnendruck"
      ],
      "properties": {
        "refraktion": {
          "type": "object",
          "title": "Refraction & visual acuity",
          "required": [
            "ferneKorrigiert",
            "naeheKorrigiert"
          ],
          "properties": {
            "ferneKorrigiert": {
              "type": "number",
              "title": "Distance visual acuity corrected",
              "minimum": 0,
              "maximum": 2
            },
            "naeheKorrigiert": {
              "type": "number",
              "title": "Corrected near visual acuity",
              "minimum": 0,
              "maximum": 2
            },
            "akkommodationGeprueft": {
              "type": "boolean",
              "title": "Accommodation/latent ametropia checked"
            }
          }
        },
        "binokular": {
          "type": "object",
          "title": "Binocular vision",
          "required": [
            "simultansehen",
            "fusion",
            "stereosehen"
          ],
          "properties": {
            "simultansehen": {
              "type": "string",
              "title": "Simultaneous viewing",
              "enum": [
                "regelrecht",
                "auffällig"
              ]
            },
            "fusion": {
              "type": "string",
              "title": "Fusion",
              "enum": [
                "regelrecht",
                "auffällig"
              ]
            },
            "stereosehen": {
              "type": "string",
              "title": "Stereo vision",
              "enum": [
                "regelrecht",
                "auffällig"
              ]
            }
          }
        },
        "peripheresGesichtsfeld": {
          "type": "string",
          "title": "Peripheral & central visual field",
          "enum": [
            "regelrecht",
            "auffällig"
          ]
        },
        "farbensinnAnomalquotient": {
          "type": "number",
          "title": "Color Sense – Anomalous Quotient",
          "minimum": 0,
          "maximum": 100
        },
        "organbefund": {
          "type": "string",
          "title": "Organ findings of all eye sections",
          "description": "Short text, confidential – not to employers"
        },
        "augeninnendruck": {
          "type": "object",
          "title": "Intraocular pressure",
          "required": [
            "gemessen",
            "wertMmHg"
          ],
          "properties": {
            "gemessen": {
              "type": "boolean",
              "title": "Measurement carried out"
            },
            "wertMmHg": {
              "type": "number",
              "title": "IOP (mmHg)",
              "minimum": 5,
              "maximum": 60
            },
            "grund": {
              "type": "string",
              "title": "Indication",
              "enum": [
                "Alter > 40",
                "Verdacht",
                "Routine"
              ]
            }
          }
        },
        "zusatzuntersuchungen": {
          "type": "string",
          "title": "Further ophthalmological examinations",
          "description": "In case of suspicion regarding the workplace/task"
        },
        "augenarzt": {
          "type": "object",
          "title": "Supplementary ophthalmological examination",
          "properties": {
            "name": {
              "type": "string",
              "title": "Name of the ophthalmologist"
            },
            "datum": {
              "type": "string",
              "format": "date",
              "title": "Date of examination"
            },
            "bescheinigungErhalten": {
              "type": "boolean",
              "title": "Ophthalmological assessment available (confidential)"
            }
          }
        }
      }
    },
    "ProgrammErst": {
      "type": "object",
      "title": "Initial examination",
      "required": [
        "art",
        "siebtest"
      ],
      "properties": {
        "art": {
          "type": "string",
          "const": "erst",
          "title": "Program"
        },
        "siebtest": {
          "$ref": "#/$defs/SiebtestVoll"
        }
      }
    },
    "ProgrammNach": {
      "type": "object",
      "title": "Follow-up examination",
      "required": [
        "art",
        "letzteUntersuchung",
        "siebtest"
      ],
      "properties": {
        "art": {
          "type": "string",
          "const": "nach",
          "title": "Program"
        },
        "letzteUntersuchung": {
          "type": "string",
          "format": "date",
          "title": "Date of last G37 investigation"
        },
        "siebtest": {
          "$ref": "#/$defs/SiebtestNach"
        }
      }
    },
    "ProgrammErgaenzung": {
      "type": "object",
      "title": "Supplementary examination",
      "required": [
        "art",
        "ausloeser",
        "siebtest",
        "detailuntersuchung"
      ],
      "properties": {
        "art": {
          "type": "string",
          "const": "ergaenzung",
          "title": "Program"
        },
        "ausloeser": {
          "type": "string",
          "title": "Reason for the additional examination",
          "enum": [
            "Auffälliger Siebtest",
            "Beschwerden",
            "Neue Sehhilfe",
            "Tätigkeitswechsel",
            "Arbeitgeberantrag"
          ]
        },
        "siebtest": {
          "$ref": "#/$defs/SiebtestVoll"
        },
        "detailuntersuchung": {
          "$ref": "#/$defs/ErgaenzungDetail"
        }
      }
    },
    "BeurteilungKeineBedenken": {
      "type": "object",
      "title": "No worries",
      "required": [
        "ergebnis",
        "naechsteUntersuchung"
      ],
      "properties": {
        "ergebnis": {
          "type": "string",
          "const": "keine_bedenken",
          "title": "Result"
        },
        "naechsteUntersuchung": {
          "type": "string",
          "format": "date",
          "title": "Recommended next follow-up"
        },
        "beratungErgonomic": {
          "type": "boolean",
          "title": "Ergonomics consultation carried out"
        }
      }
    },
    "BeurteilungMitEmpfehlungen": {
      "type": "object",
      "title": "Concerns with recommendations",
      "required": [
        "ergebnis",
        "empfehlungen",
        "naechsteUntersuchung"
      ],
      "properties": {
        "ergebnis": {
          "type": "string",
          "const": "empfehlungen",
          "title": "Result"
        },
        "empfehlungen": {
          "type": "string",
          "title": "Recommendations (non-diagnostic)",
          "description": "E.g. E.g. computer glasses, ophthalmologist, ergonomic adjustment"
        },
        "bildschirmbrilleEmpfohlen": {
          "type": "boolean",
          "title": "Computer workstation glasses recommended"
        },
        "augenarztUeberweisung": {
          "type": "boolean",
          "title": "Referral to an ophthalmologist recommended"
        },
        "naechsteUntersuchung": {
          "type": "string",
          "format": "date",
          "title": "Next follow-up"
        }
      }
    },
    "BeurteilungErgaenzungNoetig": {
      "type": "object",
      "title": "Additional examination required",
      "required": [
        "ergebnis",
        "frist"
      ],
      "properties": {
        "ergebnis": {
          "type": "string",
          "const": "ergaenzung_erforderlich",
          "title": "Result"
        },
        "frist": {
          "type": "string",
          "format": "date",
          "title": "Deadline for additional examination"
        },
        "hinweisArbeitgeber": {
          "type": "string",
          "title": "Note to employers (without details of the findings)",
          "description": "Procedural information only, no diagnoses"
        }
      }
    },
    "Attest": {
      "type": "object",
      "title": "Attestation",
      "required": [
        "arztName",
        "arztNummer",
        "ort",
        "datum"
      ],
      "properties": {
        "arztName": {
          "type": "string",
          "title": "Name of the authorized doctor"
        },
        "arztNummer": {
          "type": "string",
          "title": "Company number / LANR"
        },
        "ort": {
          "type": "string",
          "title": "Location"
        },
        "datum": {
          "type": "string",
          "format": "date",
          "title": "Date of issue"
        },
        "unterschriftErteilt": {
          "type": "boolean",
          "title": "Form issued in full"
        }
      }
    },
    "Vorgeschichte": {
      "type": "object",
      "title": "History & consents",
      "description": "G37 3.1.1 Establishing the previous history",
      "required": [
        "einwilligungDatenverarbeitung",
        "einwilligungMitteilungArbeitgeber"
      ],
      "properties": {
        "fruehereVorsorge": {
          "type": "boolean",
          "title": "Previous G37/screen precaution taken"
        },
        "letzteVorsorgeDatum": {
          "type": "string",
          "format": "date",
          "title": "Date of last preventive care"
        },
        "relevanteVorerkrankungen": {
          "type": "string",
          "title": "Relevant previous illnesses/history"
        },
        "einwilligungDatenverarbeitung": {
          "type": "boolean",
          "title": "Consent to processing the examination data"
        },
        "einwilligungMitteilungArbeitgeber": {
          "type": "boolean",
          "title": "Consent notification to employer (without diagnoses)"
        }
      },
      "if": {
        "properties": {
          "fruehereVorsorge": {
            "const": true
          }
        },
        "required": [
          "fruehereVorsorge"
        ]
      },
      "then": {
        "required": [
          "letzteVorsorgeDatum"
        ]
      }
    },
    "Beratung": {
      "type": "object",
      "title": "Occupational health advice",
      "description": "G37 Section 2.2 Advice",
      "required": [
        "durchgefuehrt"
      ],
      "properties": {
        "durchgefuehrt": {
          "type": "boolean",
          "title": "Consultation carried out"
        },
        "ergonomie": {
          "type": "boolean",
          "title": "Ergonomics/workplace design"
        },
        "bildschirmPausen": {
          "type": "boolean",
          "title": "Screen breaks"
        },

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "List of services",
  "properties": {
    "positionen": {
      "type": "array",
      "title": "Cost items",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "bezeichnung": {
            "type": "string",
            "title": "Designation"
          },
          "betrag": {
            "type": "number",
            "title": "Amount (EUR)"
          }
        },
        "required": [
          "bezeichnung",
          "betrag"
        ]
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Damage report",
  "description": "Report a claim - for vehicle, household contents and liability damage",
  "type": "object",
  "properties": {
    "vorgang": {
      "type": "object",
      "title": "Occurrence",
      "required": [
        "schadennummer",
        "meldedatum"
      ],
      "properties": {
        "schadennummer": {
          "type": "string",
          "title": "Claim number",
          "description": "Internal process number / damage ID"
        },
        "meldedatum": {
          "type": "string",
          "format": "date",
          "title": "Reporting date"
        }
      }
    },
    "versicherungsnehmer": {
      "type": "object",
      "title": "Policyholder",
      "required": [
        "nachname",
        "email",
        "policennummer"
      ],
      "properties": {
        "vorname": {
          "type": "string",
          "title": "First name"
        },
        "nachname": {
          "type": "string",
          "title": "Last name"
        },
        "email": {
          "type": "string",
          "format": "email",
          "title": "Email",
          "description": "For questions and status reports"
        },
        "telefon": {
          "type": "string",
          "format": "phone",
          "title": "Phone",
          "description": "Availability during the day"
        },
        "policennummer": {
          "type": "string",
          "title": "Policy number",
          "description": "Number from the insurance certificate"
        }
      }
    },
    "schadenfall": {
      "type": "object",
      "title": "Damage event",
      "required": [
        "schadenDatum",
        "adresse",
        "schilderung"
      ],
      "properties": {
        "schadenDatum": {
          "type": "string",
          "format": "date",
          "title": "Damage day"
        },
        "schadenzeit": {
          "type": "string",
          "title": "Approximate time",
          "description": "E.g. B. 2:30 p.m"
        },
        "adresse": {
          "type": "string",
          "title": "Location of damage (address)",
          "description": "Street, zip code, city"
        },
        "schadenortKarte": {
          "type": "object",
          "title": "Damage location (map)",
          "description": "Accident or incident location on the map",
          "x-geometry": {
            "styleUrl": "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
            "point": true,
            "line": false,
            "polygon": false,
            "maxObjects": 1
          }
        },
        "schilderung": {
          "type": "string",
          "title": "Description of the process",
          "description": "What happened?"
        },
        "polizeiAufgenommen": {
          "type": "boolean",
          "title": "Recorded by police"
        },
        "polizeiAktenzeichen": {
          "type": "string",
          "title": "Police file number",
          "description": "If recorded by the police"
        }
      }
    },
    "schadendetails": {
      "type": "object",
      "title": "Damage details",
      "required": [
        "art"
      ],
      "properties": {
        "art": {
          "title": "Damage type",
          "description": "Depending on the policy, different mandatory fields",
          "oneOf": [
            {
              "$ref": "#/$defs/SchadenKfz"
            },
            {
              "$ref": "#/$defs/SchadenHausrat"
            },
            {
              "$ref": "#/$defs/SchadenHaftpflicht"
            }
          ]
        }
      }
    },
    "beteiligte": {
      "type": "object",
      "title": "Involved",
      "properties": {
        "zeugen": {
          "type": "array",
          "title": "Witnesses",
          "items": {
            "type": "object",
            "title": "Witness",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "title": "Name"
              },
              "telefon": {
                "type": "string",
                "format": "phone",
                "title": "Phone"
              },
              "aussageKurz": {
                "type": "string",
                "title": "Quick note"
              }
            }
          }
        },
        "gegnerischePartei": {
          "type": "object",
          "title": "Opposing party (optional)",
          "properties": {
            "name": {
              "type": "string",
              "title": "Name / license plate"
            },
            "versicherung": {
              "type": "string",
              "title": "Insurance"
            },
            "kontakt": {
              "type": "string",
              "format": "phone",
              "title": "Contact"
            }
          }
        }
      }
    },
    "abschluss": {
      "type": "object",
      "title": "Diploma",
      "properties": {
        "fotosVorhanden": {
          "type": "boolean",
          "title": "Photos/documents are available"
        },
        "schadenfotos": {
          "type": "array",
          "title": "Damage photos & receipts",
          "description": "Upload photos of the damage, invoices or police reports",
          "x-file": {
            "multiple": true,
            "accept": [
              "image/*",
              "application/pdf"
            ],
            "maxFiles": 8,
            "maxSize": 10485760
          },
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "mimeType": {
                "type": "string"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "id",
              "name",
              "mimeType",
              "size"
            ]
          }
        },
        "iban": {
          "type": "string",
          "title": "IBAN for reimbursement",
          "description": "Optional if payment is desired"
        },
        "datenschutzEinwilligung": {
          "type": "boolean",
          "title": "Consent to data processing"
        },
        "wahrheitsgemasseAngaben": {
          "type": "boolean",
          "title": "Information is truthful"
        }
      }
    },
    "bearbeitungsStatus": {
      "type": "string",
      "title": "Processing status",
      "description": "Automatically derived from form progress",
      "enum": [
        "NEU",
        "GEMELDET",
        "SCHADEN_BESCHRIEBEN",
        "UNTERLAGEN_OFFEN",
        "EINGEGANGEN"
      ],
      "x-computed": {
        "expression": "!has(data.vorgang.meldedatum) || data.vorgang.meldedatum == '' ? 'NEU' : (!has(data.schadenfall.schadenDatum) || data.schadenfall.schadenDatum == '') ? 'GEMELDET' : (!has(data.schadendetails.art) || !has(data.schadendetails.art.typ)) ? 'SCHADEN_BESCHRIEBEN' : (!data.abschluss.datenschutzEinwilligung || !data.abschluss.wahrheitsgemasseAngaben) ? 'UNTERLAGEN_OFFEN' : 'EINGEGANGEN'"
      }
    }
  },
  "$defs": {
    "SchadenKfz": {
      "type": "object",
      "title": "Motor vehicle damage",
      "required": [
        "typ",
        "kennzeichen",
        "fahrbereit"
      ],
      "properties": {
        "typ": {
          "type": "string",
          "const": "kfz",
          "title": "Art"
        },
        "kennzeichen": {
          "type": "string",
          "title": "Mark"
        },
        "fahrzeugart": {
          "type": "string",
          "title": "Vehicle type",
          "enum": [
            "PKW",
            "Transporter",
            "Motorrad",
            "Anhänger"
          ]
        },
        "fahrtzweck": {
          "type": "string",
          "title": "Purpose of trip",
          "enum": [
            "Privat",
            "Dienst",
            "Arbeitsweg"
          ]
        },
        "beschaedigung": {
          "type": "string",
          "title": "Severity of damage",
          "enum": [
            "leicht",
            "mittel",
            "Totalschaden"
          ]
        },
        "fahrbereit": {
          "type": "boolean",
          "title": "Vehicle still ready to drive"
        },
        "mietwagenErforderlich": {
          "type": "boolean",
          "title": "Rental car required"
        }
      }
    },
    "SchadenHausrat": {
      "type": "object",
      "title": "Household contents damage",
      "required": [
        "typ",
        "ursache"
      ],
      "properties": {
        "typ": {
          "type": "string",
          "const": "hausrat",
          "title": "Art"
        },
        "ursache": {
          "type": "string",
          "title": "Cause of damage",
          "enum": [
            "Wasser",
            "Feuer",
            "Einbruch",
            "Sturm",
            "Sonstiges"
          ]
        },
        "betroffeneRaeume": {
          "type": "string",
          "title": "Affected rooms",
          "description": "E.g. E.g. kitchen, living room"
        },
        "gegenstaende": {
          "type": "array",
          "title": "Damaged items",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "bezeichnung"
            ],
            "properties": {
              "bezeichnung": {
                "type": "string",
                "title": "Designation"
              },
              "anschaffungsjahr": {
                "type": "integer",
                "title": "Year of purchase"
              },
              "geschaetzterWert": {
                "type": "number",
                "title": "Estimated value (EUR)"
              }
            }
          }
        }
      }
    },
    "SchadenHaftpflicht": {
      "type": "object",
      "title": "Liability damage",
      "required": [
        "typ",
        "gegenstand"
      ],
      "properties": {
        "typ": {
          "type": "string",
          "const": "haftpflicht",
          "title": "Art"
        },
        "gegenstand": {
          "type": "string",
          "title": "What was damaged?",
          "description": "Property or installation of a third party"
        },
        "personenSchaden": {
          "type": "boolean",
          "title": "Personal injury"
        },
        "verletztePerson": {
          "type": "string",
          "title": "Injured person (name)"
        },
        "aerztlichBehandelt": {
          "type": "boolean",
          "title": "Medically treated"
        },
        "geschaetzteHoehe": {
          "type": "number",
          "title": "Estimated amount of damage (EUR)"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shipping order",
  "description": "National transport order with collection, delivery and freight calculation",
  "type": "object",
  "properties": {
    "auftrag": {
      "type": "object",
      "title": "Order",
      "required": [
        "auftragsnummer",
        "auftragsdatum"
      ],
      "properties": {
        "auftragsnummer": {
          "type": "string",
          "title": "Order Number",
          "description": "Internal transport ID"
        },
        "auftragsdatum": {
          "type": "string",
          "format": "date",
          "title": "Order date"
        },
        "kundenreferenz": {
          "type": "string",
          "title": "Customer reference",
          "description": "Order or project number of the client"
        }
      }
    },
    "auftraggeber": {
      "type": "object",
      "title": "Client",
      "required": [
        "firma",
        "ansprechpartner",
        "email"
      ],
      "properties": {
        "firma": {
          "type": "string",
          "title": "Company"
        },
        "ansprechpartner": {
          "type": "string",
          "title": "Contact Person"
        },
        "email": {
          "type": "string",
          "format": "email",
          "title": "Email"
        },
        "telefon": {
          "type": "string",
          "format": "phone",
          "title": "Phone"
        },
        "rechnungskonto": {
          "type": "string",
          "title": "Billing Account",
          "enum": [
            "Standard 30 Tage",
            "Standard 14 Tage",
            "Vorkasse"
          ],
          "x-values-source": {
            "kind": "static",
            "values": [
              "Standard 30 Tage",
              "Standard 14 Tage",
              "Vorkasse"
            ]
          }
        }
      }
    },
    "abholung": {
      "type": "object",
      "title": "Pickup",
      "required": [
        "adresse",
        "abholDatum",
        "zeitfensterVon",
        "zeitfensterBis"
      ],
      "properties": {
        "adresse": {
          "type": "string",
          "title": "Pickup address"
        },
        "abholDatum": {
          "type": "string",
          "format": "date",
          "title": "Pickup date"
        },
        "zeitfensterVon": {
          "type": "string",
          "title": "Time Window From",
          "description": "HH:MM"
        },
        "zeitfensterBis": {
          "type": "string",
          "title": "Time window until",
          "description": "HH:MM"
        },
        "ladestelle": {
          "type": "string",
          "title": "Loading point",
          "enum": [
            "Rampe",
            "Tor",
            "Ebenerdig",
            "Kran erforderlich"
          ]
        },
        "standortKarte": {
          "type": "object",
          "title": "Pickup location (map)",
          "x-geometry": {
            "styleUrl": "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
            "point": true,
            "line": false,
            "polygon": false,
            "maxObjects": 1
          }
        },
        "hinweise": {
          "type": "string",
          "title": "Information for drivers"
        }
      }
    },
    "zustellung": {
      "type": "object",
      "title": "Delivery",
      "required": [
        "adresse",
        "zustellDatum",
        "zeitfensterVon",
        "zeitfensterBis"
      ],
      "properties": {
        "adresse": {
          "type": "string",
          "title": "Delivery address"
        },
        "zustellDatum": {
          "type": "string",
          "format": "date",
          "title": "Delivery date"
        },
        "zeitfensterVon": {
          "type": "string",
          "title": "Time Window From"
        },
        "zeitfensterBis": {
          "type": "string",
          "title": "Time window until"
        },
        "empfaenger": {
          "type": "string",
          "title": "Receiver on site"
        },
        "empfaengerTelefon": {
          "type": "string",
          "format": "phone",
          "title": "Telephone receiver"
        },
        "standortKarte": {
          "type": "object",
          "title": "Delivery location (map)",
          "x-geometry": {
            "styleUrl": "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
            "point": true,
            "line": false,
            "polygon": false,
            "maxObjects": 1
          }
        },
        "avisierungErforderlich": {
          "type": "boolean",
          "title": "Notification before delivery"
        }
      }
    },
    "sendung": {
      "type": "object",
      "title": "Broadcast",
      "required": [
        "leistungsart",
        "positionen"
      ],
      "properties": {
        "leistungsart": {
          "title": "Service type",
          "oneOf": [
            {
              "$ref": "#/$defs/LeistungStandard"
            },
            {
              "$ref": "#/$defs/LeistungExpress"
            },
            {
              "$ref": "#/$defs/LeistungKuehlkette"
            }
          ]
        },
        "positionen": {
          "type": "array",
          "title": "Shipment positions",
          "minItems": 1,
          "items": {
            "type": "object",
            "title": "Position",
            "required": [
              "bezeichnung",
              "anzahl",
              "gewichtKg"
            ],
            "properties": {
              "bezeichnung": {
                "type": "string",
                "title": "Name/content"
              },
              "anzahl": {
                "type": "integer",
                "title": "Number of packages",
                "minimum": 1
              },
              "gewichtKg": {
                "type": "number",
                "title": "Weight per package (kg)"
              },
              "volumenM3": {
                "type": "number",
                "title": "Volume per package (m³)"
              },
              "stapelbar": {
                "type": "boolean",
                "title": "Stackable"
              },
              "gefahrgut": {
                "type": "object",
                "title": "Dangerous goods",
                "properties": {
                  "enthaeltGefahrgut": {
                    "type": "boolean",
                    "title": "Contains dangerous goods"
                  },
                  "adrKlasse": {
                    "type": "string",
                    "title": "ADR class",
                    "enum": [
                      "Klasse 2",
                      "Klasse 3",
                      "Klasse 8",
                      "Klasse 9"
                    ]
                  },
                  "unNummer": {
                    "type": "string",
                    "title": "UN number"
                  }
                }
              }
            }
          }
        }
      }
    },
    "fahrzeug": {
      "type": "object",
      "title": "Vehicle & handling",
      "properties": {
        "fahrzeugklasse": {
          "type": "string",
          "title": "Vehicle class",
          "enum": [
            "Sprinter",
            "7,5 t",
            "12 t",
            "Sattelzug"
          ]
        },
        "zusatzleistungen": {
          "type": "object",
          "title": "Additional services",
          "properties": {
            "hebebuehne": {
              "type": "boolean",
              "title": "Lift"
            },
            "fixierung": {
              "type": "boolean",
              "title": "Lashing straps/fixation"
            },
            "zweiFahrer": {
              "type": "boolean",
              "title": "Two driver crew"
            },
            "adrAusstattung": {
              "type": "boolean",
              "title": "ADR equipment required"
            }
          }
        },
        "besonderheiten": {
          "type": "string",
          "title": "Special features"
        }
      }
    },
    "kalkulation": {
      "type": "object",
      "title": "Calculation",
      "properties": {
        "gesamtGewichtKg": {
          "type": "number",
          "title": "Total weight (kg)",
          "description": "Sum of all positions (weight × number)",
          "x-computed": {
            "expression": "data.sendung.positionen.map(p, double(p.gewichtKg) * double(p.anzahl)).sum()"
          }
        },
        "gesamtVolumenM3": {
          "type": "number",
          "title": "Total volume (m³)",
          "x-computed": {
            "expression": "data.sendung.positionen.map(p, double(p.volumenM3) * double(p.anzahl)).sum()"
          }
        },
        "frachtkostenSchaetzung": {
          "type": "number",
          "title": "Freight cost estimate (EUR)",
          "description": "Simplified estimate based on weight and power type",
          "x-computed": {
            "expression": "data.sendung.positionen.map(p, double(p.gewichtKg) * double(p.anzahl)).sum() * (has(data.sendung.leistungsart.typ) && data.sendung.leistungsart.typ == 'express' ? 1.35 : has(data.sendung.leistungsart.typ) && data.sendung.leistungsart.typ == 'kuehlkette' ? 1.55 : 0.95)"
          }
        }
      }
    },
    "freigabe": {
      "type": "object",
      "title": "Release",
      "properties": {
        "disponent": {
          "type": "string",
          "title": "Dispatcher"
        },
        "interneNotiz": {
          "type": "string",
          "title": "Internal note"
        },
        "freigegeben": {
          "type": "boolean",
          "title": "Released for disposition"
        },
        "bestaetigungAuftraggeber": {
          "type": "boolean",
          "title": "Client confirms order data"
        }
      }
    },
    "auftragsStatus": {
      "type": "string",
      "title": "Order status",
      "description": "Automatically from the editing progress",
      "enum": [
        "NEU",
        "AUFTRAG_ERFASST",
        "ROUTE_GEPLANT",
        "LADUNG_ERFASST",
        "KALKULIERT",
        "FREIGEGEBEN"
      ],
      "x-computed": {
        "expression": "!has(data.auftrag.auftragsdatum) || data.auftrag.auftragsdatum == '' ? 'NEU' : (!has(data.abholung.abholDatum) || data.abholung.abholDatum == '') ? 'AUFTRAG_ERFASST' : (!has(data.zustellung.zustellDatum) || data.zustellung.zustellDatum == '') ? 'ROUTE_GEPLANT' : (!has(data.sendung.leistungsart) || !has(data.sendung.leistungsart.typ)) ? 'LADUNG_ERFASST' : (!has(data.kalkulation.gesamtGewichtKg) || double(data.kalkulation.gesamtGewichtKg) <= 0.0) ? 'LADUNG_ERFASST' : (!data.freigabe.freigegeben || !data.freigabe.bestaetigungAuftraggeber) ? 'KALKULIERT' : 'FREIGEGEBEN'"
      }
    }
  },
  "$defs": {
    "LeistungStandard": {
      "type": "object",
      "title": "Standard",
      "required": [
        "typ",
        "maxLaufzeitTage"
      ],
      "properties": {
        "typ": {
          "type": "string",
          "const": "standard",
          "title": "Art"
        },
        "maxLaufzeitTage": {
          "type": "integer",
          "title": "Max. running time (days)",
          "enum": [
            1,
            2,
            3
          ]
        }
      }
    },
    "LeistungExpress": {
      "type": "object",
      "title": "Express",
      "required": [
        "typ",
        "zustellungBis"
      ],
      "properties": {
        "typ": {
          "type": "string",
          "const": "express",
          "title": "Art"
        },
        "zustellungBis": {
          "type": "string",
          "format": "date",
          "title": "Delivery no later than"
        },
        "festZustelltermin": {
          "type": "boolean",
          "title": "Fixed date binding"
        }
      }
    },
    "LeistungKuehlkette": {
      "type": "object",
      "title": "Cold chain",
      "required": [
        "typ",
        "minTempC",
        "maxTempC"
      ],
      "properties": {
        "typ": {
          "type": "string",
          "const": "kuehlkette",
          "title": "Art"
        },
        "minTempC": {
          "type": "number",
          "title": "Min. temperature (°C)"
        },
        "maxTempC": {
          "type": "number",
          "title": "Max. temperature (°C)"
        },
        "protokollPflicht": {
          "type": "boolean",
          "title": "Temperature log required"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Funding application",
  "properties": {
    "antragskopf": {
      "type": "object",
      "title": "Application header",
      "properties": {
        "antragsdatum": {
          "type": "string",
          "format": "date",
          "title": "Application date"
        }
      }
    },
    "auftragsdaten": {
      "type": "object",
      "title": "Order data",
      "properties": {
        "adresse": {
          "type": "string",
          "title": "Address for the application"
        }
      }
    },
    "durchfuehrung": {
      "type": "object",
      "title": "Implementation",
      "properties": {
        "datum": {
          "type": "string",
          "format": "date",
          "title": "Date of implementation"
        }
      }
    },
    "abrechnung": {
      "type": "object",
      "title": "Invoice",
      "properties": {
        "beglichen": {
          "type": "boolean",
          "title": "Bill paid"
        }
      }
    },
    "status": {
      "type": "string",
      "title": "Processing status",
      "description": "Automatically derived from the completed application",
      "enum": [
        "NEU",
        "ANTRAG_ANGELEGT",
        "BEREIT_ZUR_DURCHFUEHRUNG",
        "DURCHGEFUEHRT",
        "ERLEDIGT"
      ],
      "x-computed": {
        "expression": "!has(data.antragskopf.antragsdatum) || data.antragskopf.antragsdatum == '' ? 'NEU' : (!has(data.auftragsdaten.adresse) || data.auftragsdaten.adresse == '') ? 'ANTRAG_ANGELEGT' : (!has(data.durchfuehrung.datum) || data.durchfuehrung.datum == '') ? 'BEREIT_ZUR_DURCHFUEHRUNG' : (!data.abrechnung.beglichen) ? 'DURCHGEFUEHRT' : 'ERLEDIGT'"
      }
    }
  }
}

{
  "name": "@jsonschema-editor/react-extensions",
  "version": "0.1.8",
  "description": "React form field renderers for JSON Schema extensions (formats, values-source, computed, file, geometry)",
  "type": "module",
  "license": "MIT",
  "author": "JSON Schema Editor Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eumicro/jsonschema-editor.git",
    "directory": "jsonschema-editor-react-extensions"
  },
  "homepage": "https://github.com/eumicro/jsonschema-editor/tree/main/jsonschema-editor-react-extensions#readme",
  "bugs": "https://github.com/eumicro/jsonschema-editor/issues",
  "keywords": [
    "react",
    "json-schema",
    "form",
    "extensions",
    "email",
    "url",
    "phone"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/jsonschema-editor-react-extensions.js",
  "module": "./dist/jsonschema-editor-react-extensions.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/jsonschema-editor-react-extensions.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": ["**/*.css"],
  "scripts": {
    "prebuild": "node --input-type=module -e \"import fs from 'node:fs'; fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@geoman-io/leaflet-geoman-free": "^2.18.3",
    "leaflet": "^1.9.4"
  },
  "peerDependencies": {
    "@jsonschema-editor/json-schema": "workspace:*",
    "@jsonschema-editor/json-schema-extensions": "workspace:*",
    "@jsonschema-editor/react": "workspace:*",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@jsonschema-editor/json-schema": "workspace:*",
    "@jsonschema-editor/json-schema-extensions": "workspace:*",
    "@jsonschema-editor/react": "workspace:*",
    "@types/leaflet": "^1.9.17",
    "@types/react-dom": "^19.1.6",
    "@types/react": "^19.1.8",
    "@vitejs/plugin-react": "^4.5.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4"
  }
}

{
  "name": "@jsonschema-editor/react",
  "version": "0.1.13",
  "description": "JSON Schema form for React",
  "type": "module",
  "license": "MIT",
  "author": "JSON Schema Editor Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eumicro/jsonschema-editor.git",
    "directory": "jsonschema-editor-react"
  },
  "homepage": "https://github.com/eumicro/jsonschema-editor/tree/main/jsonschema-editor-react#readme",
  "bugs": "https://github.com/eumicro/jsonschema-editor/issues",
  "keywords": [
    "react",
    "json-schema",
    "ui-schema",
    "form"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/jsonschema-editor-react.js",
  "module": "./dist/jsonschema-editor-react.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/jsonschema-editor-react.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "prebuild": "node --input-type=module -e \"import fs from 'node:fs'; fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@jsonschema-editor/json-schema": "workspace:*",
    "@jsonschema-editor/json-schema-extensions": "workspace:*",
    "@jsonschema-editor/ui-schema": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4"
  }
}
